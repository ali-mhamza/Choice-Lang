println!(1e0);          // Expect: 1
println!(1e1);          // Expect: 10
println!(1e+1);         // Expect: 10
println!(1e-1);         // Expect: 0.1
println!(2.5e2);        // Expect: 250
println!(2.5e+2);       // Expect: 250
println!(2.5e-2);       // Expect: 0.025
println!(0.1e1);        // Expect: 1
println!(9.99e3);       // Expect: 9990
println!(7.5e-3);       // Expect: 0.0075
println!(123.456e2);    // Expect: 12345.6
println!(123.456e-2);   // Expect: 1.23456